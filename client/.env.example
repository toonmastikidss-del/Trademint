# ==================================
# CLIENT ENVIRONMENT VARIABLES
# ==================================

# Backend API Base URL
# This is the URL where your backend server is hosted
# For local development: http://localhost:5000
# For Render deployment: https://your-backend-name.onrender.com
REACT_APP_API_BASE_URL=https://your-backend-api.onrender.com

# ==================================
# IMPORTANT NOTES
# ==================================
# 1. This file should NOT be committed to version control if it contains real URLs
# 2. Use .env for local development
# 3. Use .env.production for production builds
# 4. Update REACT_APP_API_BASE_URL before building for production
# 5. After changing this file, rebuild the app: npm run build

# ==================================
# USAGE EXAMPLES
# ==================================
# Local Development (.env):
#   REACT_APP_API_BASE_URL=http://localhost:5000
#
# Production (.env.production):
#   REACT_APP_API_BASE_URL=https://trademint-server-backend.onrender.com
