# ==================================
# SERVER ENVIRONMENT VARIABLES
# ==================================

# MongoDB Connection
# CRITICAL: This is required for the application to work
# Get your connection string from MongoDB Atlas (https://cloud.mongodb.com)
# Format: mongodb+srv://<username>:<password>@cluster.<domain>/<database>?appName=<app>
MONGO_URI=your_mongodb_connection_string_here

# JWT Secret Key
# CRITICAL: Change this in production! Generate a secure random string of at least 32 characters
# Command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production

# Server Port
# Default: 5000
PORT=5000

# Node Environment
# Options: development, production, test
NODE_ENV=production

# Backend URL (for wake-up ping to prevent Render sleep mode)
# This is used by the cron job to keep the server awake
# For Render: https://your-backend-name.onrender.com
BACKEND_URL=https://your-backend-api.onrender.com

# CORS Origins
# Comma-separated list of allowed frontend URLs
# Example: https://trademint.onrender.com,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000,http://localhost:5173

# ==================================
# CLIENT ENVIRONMENT VARIABLES
# ==================================
# These should be placed in client/.env or client/.env.production

# Backend API Base URL
# This is the URL where your backend server is hosted
# For Render: https://your-backend-name.onrender.com
REACT_APP_API_BASE_URL=https://your-backend-api.onrender.com

# ==================================
# SECURITY NOTES
# ==================================
# 1. NEVER commit .env files to version control
# 2. Always use strong, randomly generated secrets in production
# 3. Keep your MongoDB credentials secure and rotate them regularly
# 4. Use environment-specific .env files (.env.development, .env.production)
# 5. Update all default passwords before deploying to production

# ==================================
# DEPLOYMENT CHECKLIST
# ==================================
# [ ] Change JWT_SECRET to a secure random value
# [ ] Update MONGO_URI with production database
# [ ] Update CORS_ORIGINS with production frontend URL
# [ ] Update REACT_APP_API_BASE_URL in client/.env.production
# [ ] Test all API endpoints after deployment
# [ ] Enable HTTPS in production
# [ ] Set up monitoring and logging